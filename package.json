{
  "name": "ecosine-auction-agent",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Daily automated screen over Al Qaryah auction inventory for Ecosine Transport fleet purchasing.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "login": "tsx src/auth.ts",
    "run": "tsx src/index.ts",
    "calibrate": "tsx src/calibrate.ts",
    "watch": "tsx src/watcher.ts",
    "preview": "tsx src/preview.ts",
    "verify": "tsx src/verify.ts",
    "check:responsive": "tsx src/preview.ts && tsx src/responsive.ts",
    "preflight": "tsx src/preflight.ts",
    "scheduler": "tsx src/scheduler.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^16.4.7",
    "nodemailer": "^6.10.0",
    "pg": "^8.22.0",
    "playwright": "^1.50.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
