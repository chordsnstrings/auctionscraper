# ── Vision model ────────────────────────────────────────────────────────────
# The damage assessment runs on BytePlus ModelArk by default. It is the only
# per-lot cost in the pipeline, so it runs on the cheaper capable model rather
# than a frontier one.
ARK_API_KEY=ark-...
# Optional. Defaults shown.
# ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3
# ARK_VISION_MODEL=seed-2-0-pro-260328

# Switch the assessment to Claude instead — worth it for a calibration run you
# intend to grade ModelArk against, not for a daily screen.
# VISION_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# ── SMTP (digest delivery, §9) ──────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
DIGEST_FROM="Ecosine Auction Intelligence <auctions@ecosine.ae>"
DIGEST_TO=purchasing@ecosine.ae

# ── Optional overrides ──────────────────────────────────────────────────────
# Skip the vision stage entirely (calibration runs, dry runs).
# VISION_ENABLED=false
# Write the rendered digest to disk instead of sending.
# DIGEST_DRY_RUN=true
